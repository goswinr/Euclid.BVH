<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- FsDoc will use the first target framework: https://fsprojects.github.io/FSharp.Formatting/apidocs.html#Selected-projects -->
    <TargetFrameworks>net6.0;net472</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>    <!--to only have the english resources for FSharp.Core-->
    <RootNamespace>Euclid</RootNamespace>
    <AssemblyName>Euclid.BVH</AssemblyName>
    <AssemblyTitle>Euclid.BVH</AssemblyTitle>
    <Title>Euclid.BVH</Title>
    <Product>Euclid.BVH</Product>
    <PackageId>Euclid.BVH</PackageId>    <!-- <Version></Version>  done by Ionide.KeepAChangelog.Tasks-->
    <Authors>GoswinR</Authors>
    <Copyright>Goswin Rothenthal 2025-2026</Copyright>
    <Description>A Bounding Volume Hierarchy (BVH) for fast spatial queries on the Euclid geometry library. Find closest lines and pairs of close lines among thousands of 3D lines.</Description>
    <PackageDescription>A Bounding Volume Hierarchy (BVH) for fast spatial queries on the Euclid geometry library. Find closest lines and pairs of close lines among thousands of 3D lines.</PackageDescription>    <!--used on nuget.org-->
    <WarningLevel>5</WarningLevel>    <!-- WarningLevel 3 is default, see https://github.com/dsyme/fsharp-presentations/blob/master/design-notes/off-by-default-warnings.md -->
    <OtherFlags>$(OtherFlags) --warnon:3390</OtherFlags>    <!-- warnon:3390 is to verify xml docstrings https://devblogs.microsoft.com/dotnet/announcing-f-5/#improved-compiler-analysis-for-library-authors -->
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>    <!-- 1182: warn on unused variables -->
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>fsharp;geometry;bvh;spatial-index;fable;fable-library</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/goswinr/Euclid.BVH</RepositoryUrl>
    <FsDocsLicenseLink>https://github.com/goswinr/Euclid.BVH/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/goswinr/Euclid.BVH/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>
    <PackageProjectUrl>https://goswinr.github.io/Euclid.BVH</PackageProjectUrl>
    <FsDocsWarnOnMissingDocs>true</FsDocsWarnOnMissingDocs>
    <ChangelogFile>./CHANGELOG.md</ChangelogFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="6.0.7" />
    <PackageReference Include="Euclid" Version="0.51.0" />
    <PackageReference Include="Fable.Core" Version="4.5.0" Condition="$(DefineConstants.Contains('FABLE_COMPILER'))" />    <!-- needed by the Fable sources of the Euclid package -->

    <!-- build time only : -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />

    <None Include="./README.md" Pack="true" PackagePath="" />
    <Content Include="*.fsproj; **/*.fs; **/*.fsi" PackagePath="fable/" />    <!--so that it can be used with Fable-->

    <Compile Include="Src/Bvh.fs" />
    <Compile Include="Src/LineBvh.fs" />
  </ItemGroup>

  <Target Name="CopyReadmeToDocs" AfterTargets="Build">    <!-- for fsdocs to build locally -->
    <Copy SourceFiles="./README.md" DestinationFiles="./Docs/index.md" ContinueOnError="false" />
  </Target>

  <Target Name="WriteChangelogVersion" AfterTargets="AfterBuild">    <!-- for checking that the git tag matches the Changelog during github tag based builds -->
    <WriteLinesToFile File="./bin/ChangelogVersion.txt" Lines="@(CurrentReleaseChangelog)" Overwrite="true" ContinueOnError="false" />
  </Target>

</Project>
