<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Optimize>true</Optimize>
    <!-- With debug symbols the F# compiler marks the assembly for JIT tracking, which BenchmarkDotNet
         reports as DEBUG, even though .NET ignores that flag and the code is fully optimized. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Fable.Core" Version="4.5.0" />    <!-- for the JavaScript timer in Portable.fs -->
    <ProjectReference Include="../../Src/Euclid.BVH.fsproj" />

    <Compile Include="Shared.fs" />
    <Compile Include="Portable.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
